doctype html
html(lang="pt-BR")
  head
    title= title
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    
    // Importando o Tailwind via CDN para uso imediato
    script(src="https://cdn.tailwindcss.com")
    
    // Arquivo CSS local original do Express
    link(rel="stylesheet", href="/stylesheets/style.css")
    
  body(class="bg-[#F7F5F0] text-gray-900 font-serif min-h-screen flex flex-col")

    // NAVBAR
    nav(class="w-full px-8 py-6 border-b border-gray-200")
      div(class="max-w-6xl mx-auto flex justify-between items-center")
        div(class="flex items-center gap-6")
          a(href="/", class="text-2xl font-bold tracking-wider") LOGO
          a(href="/", class="text-lg hover:text-gray-500 transition") Home
        div(class="flex items-center gap-6 text-lg")
          a(href="/artigos", class="hover:text-gray-500 transition") Artigos e Textos
          a(href="/projetos", class="hover:text-gray-500 transition") Projetos
          a(href="/sobre", class="hover:text-gray-500 transition") Sobre Mim
          a(href="/contato", class="hover:text-gray-500 transition") Contato

    // CONTEÚDO DINÂMICO (INJETADO PELAS OUTRAS PÁGINAS)
    main(class="flex-grow w-full max-w-6xl mx-auto px-8 py-12")
      block content

    // FOOTER
    footer(class="w-full border-t border-gray-200 mt-12 py-8 text-center")
      div(class="flex justify-center gap-6 mb-4 text-sm")
        a(href="/", class="hover:text-gray-500") Home
        a(href="/artigos", class="hover:text-gray-500") Artigos e Textos
        a(href="/projetos", class="hover:text-gray-500") Projetos
        a(href="/sobre", class="hover:text-gray-500") Sobre Mim
        a(href="/contato", class="hover:text-gray-500") Contato
      p(class="text-xs text-gray-500") &copy; 2026 Seu Nome. Todos os direitos reservados.